  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 837627622}
  m_Text: "NIGHT RULES\n\n1. Lights out at nine.\n2. No crying after the bell.\n3. Children who are awake\n    are sent downstairs.\n4. Madam Night keeps the bell."
