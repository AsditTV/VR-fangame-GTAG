  - {fileID: 8300000, guid: f5ac60acd06948343a5a11d21a242d81, type: 3}
  whisperLines:
  - You breathed too loud.
  - She heard your heart.
  - 'Mila hid under the bed.

    Hide like Mila.'
  - 'Don''t run.

    She hears running.'
  - We were twenty-three.
  - 'The Softies move

    when you look away.'
  - Odette is still in the water.
  - 'Count the doors.

    One is missing.'
  - 'Now you know

    why we whisper.'
  - 'Find my drawing.

    Please.'
  minBlackTime: 2.2
  maxBlackTime: 3.2
  forceWhisper: -1
