  m_EditorClassIdentifier: Assembly-CSharp::Horror.Player.Jumpscare
  sting: {fileID: 8300000, guid: 3fe8a3ca072f10740b7081158d31f7a9, type: 3}
  volume: 1
  faceTime: 0.9
  fadeOutTime: 0.35
  blackTime: 0.6
  fadeInTime: 0.9
