  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1323471811}
  m_Text: 'QUIET PLEASE.

    THE DOCTOR IS LISTENING

    FOR NOTHING BUT CRASHES.

    HE SEES WHAT HIS LAMP SEES.'
