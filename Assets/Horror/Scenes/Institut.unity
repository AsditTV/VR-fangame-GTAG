--- !u!114 &219263667
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 219263666}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 49f3c9c123c0ac14b9cf1e74bfa09c97, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Horror.Lore.StandardPhone
  button: {fileID: 455489334}
  text: {fileID: 45724541}
  ring: {fileID: 8300000, guid: 7826d00bd3ceace4a937bcf562f33b21, type: 3}
  whisper: {fileID: 8300000, guid: 56b476cba4dfa9a429bb80b7aae7ca03, type: 3}
  delayRange: {x: 90, y: 210}
  ringTime: 12
  ringNoise: 13
  messages:
  - '...Mila? Mila, answer me.

    It''s too loud. I can''t hear you...'
  - 'Room 23 does not exist.

    Stop counting the doors, Armand.'
  - 'Odette flooded the laundry.

    Celeste won''t go near the water.'
  - 'The Softies want to play.

    Don''t look away. Don''t look away.'
  - 'If you hear the keys,

    stop breathing.'
  - 'She erased her own eyes

    so she wouldn''t see our faces.'
