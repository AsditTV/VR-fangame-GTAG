  m_Script: {fileID: 11500000, guid: 97b4af7b933d6094ea1650393404e6fc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Horror.Lore.LoreTape
  id: cassette_1
  label: TAPE 1
  clip: {fileID: 8300000, guid: 1b4d6be8d0fb0fe48b445c3d72e518c7, type: 3}
  playButton: {fileID: 1224870523}
  subtitle: {fileID: 131962581}
  lines:
  - Night log. November the second.
  - Lights out at nine, as Madam wants.
  - Number twelve cried again.
  - 'I told her: the dark is kind.'
  - The dark keeps you quiet.
  - If you see the light, you are awake.
  - And awake children... get tested.
  clickSound: {fileID: 8300000, guid: 6240168bfbb5e5c459848e3e0319b4f9, type: 3}
  leadIn: 0.55
