  id: cassette_2
  label: TAPE 2
  clip: {fileID: 8300000, guid: 5683a56cacb0110418e330e070a1aea4, type: 3}
  playButton: {fileID: 811849721}
  subtitle: {fileID: 300291313}
  lines:
  - If somebody hears this.
  - She is coming up the attic stairs.
  - I can hear the brass bell.
  - She puts the bulbs out, one by one.
  - Don't let them all go out.
  - Pull the strings. Pull the strings!
  clickSound: {fileID: 8300000, guid: 6240168bfbb5e5c459848e3e0319b4f9, type: 3}
  leadIn: 0.55
