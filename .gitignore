# --- Unity : dossiers générés automatiquement (ne JAMAIS les mettre sur Git) ---
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Fichiers générés par les IDE (Visual Studio, Rider, VS Code)
.vs/
.idea/
.vscode/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Fichiers de crash et builds
sysinfo.txt
crashlytics-build.properties
*.apk
*.aab
*.unitypackage

# Système
.DS_Store
Thumbs.db

# Secrets : clés Photon / PlayFab / etc. ne doivent jamais être commitées
*.secret
secrets.json

# Python (scripts de Tools/)
__pycache__/
*.pyc

# Fichiers temporaires des outils de build Android
/.utmp/

# SDK Photon (Fusion 2.1.4 + Voice 2.64) : installé à part, jamais sur le dépôt public
# (licence Photon, et PhotonAppSettings contient les App ID). Voir Docs/MULTIJOUEUR.md.
/[Aa]ssets/Photon/
/[Aa]ssets/Photon.meta

# sauvegardes de scène créées par Unity après un arrêt brutal
/[Aa]ssets/_Recovery/
/[Aa]ssets/_Recovery.meta
